{
  "name": "minecraft-toolkit",
  "version": "2.1.0",
  "description": "Minecraft toolkit for Node.js: Java and Bedrock server status, player UUID and skin lookup, skin head renders, Votifier, RCON, and color code and MiniMessage conversion.",
  "keywords": [
    "bedrock",
    "minecraft",
    "minecraft-api",
    "minecraft-bedrock",
    "minecraft-motd",
    "minecraft-ping",
    "minecraft-player",
    "minecraft-rcon",
    "minecraft-server",
    "minecraft-server-status",
    "minecraft-skins",
    "minecraft-status",
    "minecraft-tools",
    "minecraft-utils",
    "minecraft-uuid",
    "minecraft-votifier",
    "minimessage",
    "mojang",
    "mojang-api",
    "nuvotifier",
    "rcon",
    "skin-render",
    "votifier"
  ],
  "homepage": "https://github.com/26bz/minecraft-toolkit",
  "bugs": {
    "url": "https://github.com/26bz/minecraft-toolkit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "26bz",
    "email": "26bz@proton.me",
    "url": "https://26bz.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/26bz/minecraft-toolkit"
  },
  "funding": "https://ko-fi.com/26bzz",
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./h3": {
      "types": "./src/h3/routes.d.ts",
      "default": "./src/h3/routes.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "docs:sync": "automd"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "automd": "^0.4.3",
    "h3": "^2.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "h3": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
